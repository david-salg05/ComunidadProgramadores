<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../../../CSS/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.comunidadprogramadores.Registro_Controller">
   <children>
      <Label id="titulo" layoutX="175.0" layoutY="14.0" prefHeight="36.0" prefWidth="250.0" text="Registro usuarios" />
      <VBox layoutX="191.0" layoutY="100.0" prefHeight="200.0" prefWidth="371.0">
         <children>
            <HBox prefHeight="43.0" prefWidth="371.0">
               <children>
                  <Label id="label" prefHeight="22.0" prefWidth="129.0" text="Nombre de usuario:" />
                  <TextField fx:id="regUsu" prefHeight="25.0" prefWidth="186.0" promptText="Introduce el nombre de usuario" />
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="38.0" prefWidth="371.0">
               <children>
                  <Label id="label" prefHeight="22.0" prefWidth="129.0" text="Contraseña:" />
                  <TextField fx:id="regContr" prefHeight="25.0" prefWidth="149.0" promptText="Introduce la contraseña" />
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="53.0" prefHeight="82.0" prefWidth="371.0">
               <children>
                  <Label id="label" prefHeight="22.0" prefWidth="129.0" text="Género:" />
                  <VBox prefHeight="82.0" prefWidth="158.0">
                     <children>
                        <RadioButton fx:id="hombre" mnemonicParsing="false" prefHeight="19.0" prefWidth="87.0" text="Hombre">
                           <toggleGroup>
                              <ToggleGroup fx:id="idGenero" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="mujer" mnemonicParsing="false" prefHeight="31.0" prefWidth="87.0" text="Mujer" toggleGroup="$idGenero" />
                        <RadioButton fx:id="pnd" mnemonicParsing="false" prefHeight="17.0" prefWidth="141.0" text="Prefiero no decirlo" toggleGroup="$idGenero" />
                     </children></VBox>
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="53.0" prefHeight="38.0" prefWidth="371.0">
               <children>
                  <Label id="label" fx:id="label" prefHeight="36.0" prefWidth="126.0" text="Lenguaje de &#10;programación: " />
                  <ComboBox fx:id="comboBox" prefHeight="25.0" prefWidth="154.0" promptText="Selecciona lenguaje" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Button id="button" layoutX="128.0" layoutY="322.0" mnemonicParsing="false" onAction="#registrarUsuario" text="Registrar" />
      <Button id="button" layoutX="336.0" layoutY="322.0" mnemonicParsing="false" onAction="#volverLogin" text="Volver al Login" />
      <ImageView fitHeight="129.0" fitWidth="103.0" layoutX="60.0" layoutY="61.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../Imagenes/rg.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
