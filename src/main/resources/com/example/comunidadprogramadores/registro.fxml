<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.comunidadprogramadores.Registro_Controller">
   <children>
      <Label layoutX="250.0" layoutY="14.0" prefHeight="36.0" prefWidth="100.0" text="Registro usuarios" />
      <VBox layoutX="114.0" layoutY="73.0" prefHeight="200.0" prefWidth="371.0">
         <children>
            <HBox prefHeight="43.0" prefWidth="371.0">
               <children>
                  <Label prefHeight="22.0" prefWidth="129.0" text="Nombre de usuario:" />
                  <TextField fx:id="regUsu" prefHeight="5.0" prefWidth="134.0" />
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="38.0" prefWidth="371.0">
               <children>
                  <Label prefHeight="22.0" prefWidth="129.0" text="Contraseña:" />
                  <TextField fx:id="regContr" prefHeight="5.0" prefWidth="134.0" />
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="53.0" prefHeight="82.0" prefWidth="371.0">
               <children>
                  <Label prefHeight="22.0" prefWidth="129.0" text="Género:" />
                  <VBox prefHeight="82.0" prefWidth="158.0">
                     <children>
                        <RadioButton fx:id="hombre" mnemonicParsing="false" prefHeight="19.0" prefWidth="87.0" text="Hombre">
                           <toggleGroup>
                              <ToggleGroup fx:id="idGenero" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="mujer" mnemonicParsing="false" prefHeight="31.0" prefWidth="87.0" text="Mujer" toggleGroup="$idGenero" />
                        <RadioButton fx:id="pnd" mnemonicParsing="false" prefHeight="17.0" prefWidth="141.0" text="Prefiero no decirlo" toggleGroup="$idGenero" />
                     </children></VBox>
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="53.0" prefHeight="38.0" prefWidth="371.0">
               <children>
                  <Label fx:id="label" prefHeight="36.0" prefWidth="126.0" text="Lenguaje de &#10;programación: " />
                  <ComboBox fx:id="comboBox" prefHeight="25.0" prefWidth="154.0" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Button layoutX="135.0" layoutY="294.0" mnemonicParsing="false" onAction="#registrarUsuario" text="Registrar" />
      <Button layoutX="334.0" layoutY="294.0" mnemonicParsing="false" onAction="#volverLogin" text="Volver al Login" />
   </children>
</AnchorPane>
